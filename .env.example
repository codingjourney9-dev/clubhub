# ─────────────────────────────────────────────────────────────────────────────
# ClubHub environment template.
#   cp .env.example .env
# Only .env.example is committed; .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# Pool multi-tenancy: ONE database, every core table carries a tenant_id column.
# The local dev database runs on the standard port 5432.
DATABASE_URL="postgresql://clubhub:clubhub@localhost:5432/clubhub?schema=public"

# Optional: max Postgres connections THIS process may open (pg's default is 10).
# On serverless (Vercel, Lambda) use a small number such as 1 — every warm
# instance has its own pool, and free database plans cap total connections.
# DATABASE_POOL_MAX="1"

# Optional: the DIRECT (non-pooled) Postgres URL used by `prisma migrate deploy`.
# Only needed when DATABASE_URL points at a pooler (PgBouncer / Neon / Supabase),
# because migrations take advisory locks and run DDL, which transaction-mode
# poolers do not allow. Falls back to DATABASE_URL when unset.
# DIRECT_DATABASE_URL="postgresql://user:pass@db-host:5432/clubhub?schema=public"

# Auth.js v5 session secret. Generate with: npx auth secret
# Must be at least 32 characters — src/lib/env.ts refuses to boot otherwise.
AUTH_SECRET="replace-me-with-at-least-32-random-characters"

# Canonical origin used to build auth callback URLs.
AUTH_URL="http://localhost:3000"

# Required when the app runs behind a reverse proxy (including the sandbox
# preview proxy, which terminates TLS and forwards to Next.js).
AUTH_TRUST_HOST="true"

# Fallback tenant timezone. Every Event timestamp is still PERSISTED in UTC;
# this only decides how naive form input is interpreted and how dates render.
DEFAULT_TENANT_TIMEZONE="Asia/Kolkata"

# Rate limiting backend.
# Only `memory` exists: a per-process token bucket. It is honest for dev and for a
# single-instance deployment; with N instances each gets its own budget.
# Setting `redis` (or any other value) now FAILS AT BOOT on purpose — a shared
# bucket has to be implemented before it can be promised. See
# src/lib/rate-limit/driver.ts.
RATE_LIMIT_DRIVER="memory"

# Public origin exposed to the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Read-only /demo preview (renders the member dashboard without cookies).
# Off automatically in production unless set to "on" — see src/lib/demo/mode.ts.
DEMO_MODE="on"
