# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Prisma 7 generates its typed client into the source tree (npm run postinstall → prisma generate)
/src/generated

# local Postgres cluster lives outside the repo (see scripts/db.sh)
/pgdata

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal scratch scripts
*.local.mjs
