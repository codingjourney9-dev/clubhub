# npm settings shared by every install of this project.
#
# `legacy-peer-deps` is needed because `vitest` lists `canvas` as an optional
# peer dependency, and npm's resolver crashes on it ("Cannot read properties of
# null (reading 'edgesOut')") on a clean install. Setting it here means every
# path — `npm install`, `npm run app:up`, and a fresh checkout on someone else's
# machine — resolves the same way instead of only the ones that remembered the flag.
legacy-peer-deps=true
