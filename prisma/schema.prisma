// ClubHub data model — pool multi-tenancy.
//
// Conventions enforced here (see docs/architecture.md §2):
//   • Every core table carries `tenantId`, including tables reachable through a
//     club, so a scoped query is always a single-column filter.
//   • Child rows are bound to their parent with COMPOSITE foreign keys that
//     include `tenantId` (e.g. Event(clubId, tenantId) → Club(id, tenantId)).
//     That makes a tenant mismatch structurally impossible, not just a code rule.
//   • Timestamps are TIMESTAMPTZ (always UTC); rendering happens client-side.
//   • Deletion is soft (`deletedAt`) wherever history must survive.
//   • Ticket secrets (`qrCodeUuid`) are separate from ticket ids so a leaked id
//     cannot forge a check-in.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Load `include`d relations with one LATERAL JOIN query instead of one query
  // per relation. Against a remote database every query is a network round
  // trip (~80–250 ms from India), so this alone cuts most pages by a third.
  // Preview in Prisma 7, verified against @prisma/adapter-pg by the test suite.
  previewFeatures = ["relationJoins"]
}

datasource db {
  // Prisma 7: the connection URL lives in prisma7.config.ts (CLI) and is passed
  // to PrismaClient as a driver adapter (runtime) — not here.
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ClubRole {
  PRESIDENT
  EVENT_MANAGER
  MEMBER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// A fixed vocabulary on purpose: "Tech", "tech" and "Technical" must not become
/// three different filters on the public board.
enum EventTag {
  TECHNICAL
  CULTURAL
  WORKSHOP
  SPORTS
  COMPETITION
  TALK
  MUSIC
  ARTS
  SOCIAL
  CAREER
}

enum TicketStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum AttendanceSource {
  SCANNER
  MANUAL
}

// ────────────────────────── Identity ──────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String?   @map("password_hash")
  // Optional at the storage layer because non-password sign-in paths (OAuth,
  // emailed invites) may not carry a name; the registration flow requires both.
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  avatarUrl    String?   @map("avatar_url")
  // Display timezone override; falls back to the active tenant's timezone.
  timezone     String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenantMemberships TenantMember[]
  clubMemberships   ClubMember[]
  tickets           Ticket[]
  createdEvents     Event[]              @relation("EventCreatedBy")
  checkIns          Attendance[]         @relation("AttendanceCheckedInBy")
  tenantInvites     TenantInvite[]       @relation("TenantInviteCreatedBy")
  clubInvites       ClubInvite[]         @relation("ClubInviteCreatedBy")
  announcements     Announcement[]       @relation("AnnouncementAuthor")
  openingsPosted    RoleOpening[]        @relation("OpeningPostedBy")
  applications      OpeningApplication[] @relation("ApplicationApplicant")
  decisions         OpeningApplication[] @relation("ApplicationDecidedBy")

  @@index([deletedAt])
  @@map("users")
}

// ────────────────────────── Tenancy ──────────────────────────

model Tenant {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  slug     String  @unique
  /// Verified email domain for auto-joining, e.g. "college.edu".
  domain   String? @unique
  /// IANA timezone used to interpret naive scheduling input.
  timezone String  @default("Asia/Kolkata")

  /// { primaryColor, logoUrl, faviconUrl, ... } as JSON so tenants can be
  /// themed without a schema migration.
  brandingSettings Json      @default("{}") @map("branding_settings")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  members TenantMember[]
  clubs   Club[]
  invites TenantInvite[]

  @@map("tenants")
}

model TenantMember {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      TenantRole @default(MEMBER)
  joinedAt  DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Membership history is preserved: leaving sets this instead of deleting.
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, role])
  @@map("tenant_members")
}

// ────────────────────────── Clubs ──────────────────────────

model Club {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  category    String?
  logoUrl     String? @map("logo_url")

  /// Phase 12. A student's new club is PENDING until a professor's 6-digit
  /// code is entered; clubs made by college Owners/Admins start ACTIVE.
  status       ClubStatus @default(ACTIVE)
  /// When the professor's code was accepted. Null for admin-made clubs.
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(3)
  /// The professor who vouched for the club (email required for student clubs).
  facultyName  String?    @map("faculty_name")
  facultyEmail String?    @map("faculty_email")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       ClubMember[]
  events        Event[]
  invites       ClubInvite[]
  announcements Announcement[]
  openings      RoleOpening[]
  verification  ClubVerification?

  /// Composite target for child rows: guarantees an event's tenantId matches
  /// the tenant of its club.
  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@map("clubs")
}

enum ClubStatus {
  PENDING
  ACTIVE
}

/// Phase 12: the professor's one-time code for a PENDING club. One row per
/// club; sending a new code overwrites it. Only a hash of the code is kept.
model ClubVerification {
  id       String @id @default(uuid()) @db.Uuid
  clubId   String @unique @map("club_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Where the code was (notionally) sent.
  email    String
  /// HMAC-SHA256 of "clubId:code", keyed with AUTH_SECRET.
  codeHash String @map("code_hash")
  /// Plain code, stored ONLY while demo/dev reveal is on so the pending page
  /// can show it. Always null on a real deployment.
  demoCode String? @map("demo_code")
  attempts Int    @default(0)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSentAt DateTime  @map("last_sent_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  club Club @relation(fields: [clubId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([clubId, tenantId])
  @@index([tenantId])
  @@map("club_verifications")
}

model ClubMember {
  id        String    @id @default(uuid()) @db.Uuid
  clubId    String    @map("club_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Role is per club: the same user can be PRESIDENT here and MEMBER elsewhere.
  role      ClubRole  @default(MEMBER)
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId, role])
  @@map("club_members")
}

/// Shareable, single-use invite link for joining a tenant (college).
///
/// Why links rather than email invitations: students often do not have an
/// account yet, and sending mail would require an external provider. A link can
/// be pasted into a class group chat and works for anyone with the address.
///
/// The `token` is an opaque secret and is the ONLY identifier exposed in the
/// URL — invite ids are never sent to the browser, so an id leak cannot be
/// turned into a join.
model TenantInvite {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  token String     @unique
  role  TenantRole

  /// Optional: restricts the link to one address. Null means "anyone with the link".
  email String?

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  maxUses   Int       @default(1) @map("max_uses")
  uses      Int       @default(0)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TenantInviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("tenant_invites")
}

/// Shareable, single-use invite link for joining a club.
/// `role` is pre-set by whoever creates the link, so a President can hand out a
/// plain Member link without giving away Event Manager powers.
model ClubInvite {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clubId   String @map("club_id") @db.Uuid

  token String   @unique
  role  ClubRole

  email String?

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  maxUses   Int       @default(1) @map("max_uses")
  uses      Int       @default(0)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  club      Club @relation(fields: [clubId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy User @relation("ClubInviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@map("club_invites")
}

// ────────────────────────── Events ──────────────────────────

model Event {
  id          String  @id @default(uuid()) @db.Uuid
  /// Denormalised tenancy root (architecture §3): every scoped query is one filter.
  tenantId    String  @map("tenant_id") @db.Uuid
  clubId      String  @map("club_id") @db.Uuid
  title       String
  description String?
  location    String?

  startTime DateTime @map("start_time") @db.Timestamptz(3)
  endTime   DateTime @map("end_time") @db.Timestamptz(3)

  /// NULL means unlimited. Non-null values are enforced under a row lock in
  /// Phase 5 (SELECT … FOR UPDATE) so concurrent RSVPs cannot overbook.
  capacity        Int?
  waitlistEnabled Boolean     @default(false) @map("waitlist_enabled")
  status          EventStatus @default(DRAFT)
  /// true  → visible to everyone in the tenant
  /// false → visible only to club members
  isPublic        Boolean     @default(false) @map("is_public")

  /// Poster image — a pasted https link (or a site-relative path for seeded
  /// demo posters). Never fetched by the server, only rendered by browsers.
  posterUrl    String?    @map("poster_url")
  /// At most 3, from the fixed vocabulary above.
  tags         EventTag[] @default([])
  /// Public: shown to everyone who can see the event.
  instagramUrl String?    @map("instagram_url")
  /// NOT public: only organisers and people holding a ticket ever receive it,
  /// so a public event doesn't hand its group chat to spammers.
  whatsappUrl  String?    @map("whatsapp_url")

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// onDelete: Restrict — a club with events cannot be hard-deleted; both are
  /// soft-deleted in the product, so history (tickets, attendance) survives.
  club       Club         @relation(fields: [clubId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy  User?        @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tickets    Ticket[]
  attendance Attendance[]

  @@unique([id, tenantId])
  @@index([tenantId, startTime])
  @@index([clubId, status, deletedAt])
  @@index([tenantId, isPublic, deletedAt])
  @@index([tags], type: Gin)
  @@map("events")
}

// ────────────────────────── Ticketing ──────────────────────────

model Ticket {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// Opaque secret embedded in the QR image. Unique and separate from `id`.
  qrCodeUuid String @unique @map("qr_code_uuid") @db.Uuid

  status           TicketStatus @default(REGISTERED)
  /// FIFO position when WAITLISTED; cleared on promotion.
  waitlistPosition Int?         @map("waitlist_position")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  event      Event       @relation(fields: [eventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendance Attendance?

  /// One ticket per person per event — the database, not the UI, is what makes
  /// double-registration impossible. Re-registering revives this row instead.
  @@unique([eventId, userId])
  @@unique([id, tenantId])
  @@index([eventId, status])
  @@index([userId, createdAt])
  @@map("tickets")
}

model Attendance {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  /// One check-in per ticket.
  ticketId String @unique @map("ticket_id") @db.Uuid

  checkInTime   DateTime         @default(now()) @map("check_in_time") @db.Timestamptz(3)
  source        AttendanceSource @default(SCANNER)
  /// Staff member who performed the check-in; nulled if that account is purged.
  checkedInById String?          @map("checked_in_by") @db.Uuid
  /// Client-generated idempotency key from the offline scanner queue (Phase 6):
  /// replays of the same scan collapse into one row.
  scanUuid      String?          @unique @map("scan_uuid") @db.Uuid
  deviceLabel   String?          @map("device_label")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event       Event  @relation(fields: [eventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  ticket      Ticket @relation(fields: [ticketId, tenantId], references: [id, tenantId], onDelete: Restrict)
  checkedInBy User?  @relation("AttendanceCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  /// One check-in per ticket (and the composite target for the ticket relation).
  @@unique([ticketId, tenantId])
  @@index([eventId, checkInTime])
  @@index([checkedInById])
  @@map("attendance")
}

/// A message from a club's Leads/President to its members — never public.
///
/// Rules the database holds on its own (hand-written in the migration, because
/// Prisma's schema language can't say them without a preview feature):
///   • at most ONE pinned announcement per club (partial unique index);
///   • title and body length limits (CHECK), matching the Zod schema.
model Announcement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clubId   String @map("club_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid

  title String @db.VarChar(120)
  /// Plain text. Rendered as text (never HTML), line breaks preserved.
  body  String

  pinnedAt DateTime? @map("pinned_at") @db.Timestamptz(3)
  /// Set when the author changes the text — shown as "edited".
  editedAt DateTime? @map("edited_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  club   Club @relation(fields: [clubId, tenantId], references: [id, tenantId], onDelete: Cascade)
  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([clubId, deletedAt, createdAt])
  @@index([tenantId])
  @@map("announcements")
}

enum OpeningStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// A role a club is recruiting for (Phase 11). Public: guests can read it.
///
/// "Open" means status = OPEN and (closesAt is null or in the future); the
/// optional date closes it without anyone pressing a button.
model RoleOpening {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  clubId      String @map("club_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid

  title        String   @db.VarChar(120)
  description  String
  requirements String?
  /// The role accepting grants: MEMBER or EVENT_MANAGER (shown as "Lead").
  /// Never PRESIDENT — a CHECK in the migration holds that line.
  role         ClubRole @default(MEMBER)
  /// 1–3 questions every applicant answers (CHECK in the migration).
  questions    String[]

  status   OpeningStatus @default(OPEN)
  closesAt DateTime?     @map("closes_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  club         Club                 @relation(fields: [clubId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy    User                 @relation("OpeningPostedBy", fields: [createdById], references: [id], onDelete: Restrict)
  applications OpeningApplication[]

  /// Composite target, so an application's tenant always matches its opening's.
  @@unique([id, tenantId])
  @@index([status, deletedAt, createdAt])
  @@index([clubId, deletedAt])
  @@map("role_openings")
}

/// One person's application to one opening. The applicant may come from any
/// college; `tenantId` is the CLUB's college (whose data this is).
model OpeningApplication {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  openingId   String @map("opening_id") @db.Uuid
  applicantId String @map("applicant_id") @db.Uuid

  /// [{ question, answer }] — the questions are copied in, so editing an
  /// opening later never changes what somebody already answered.
  answers Json

  status      ApplicationStatus @default(PENDING)
  decidedById String?           @map("decided_by_id") @db.Uuid
  decidedAt   DateTime?         @map("decided_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  opening   RoleOpening @relation(fields: [openingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  applicant User        @relation("ApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  decidedBy User?       @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  /// One application per person per opening — a double click can't make two.
  @@unique([openingId, applicantId])
  @@index([applicantId, createdAt])
  @@index([openingId, status])
  @@map("opening_applications")
}
